# ============================================================================
# 架電特化型SaaS の環境変数
#
# これを .env にコピーして値を入れる。
#
# ★ 起動時に「全部まとめて」検証する。1 件ずつ投げると、コンテナデプロイでは
#   6 件足りないときに 6 回デプロイし直すことになる。
# ============================================================================

# ---------------------------------------------------------------- 基本

APP_ENV=development                 # development | staging | production
PORT=8000
MEDIA_PORT=8001                     # ★ 音声 WSS は別ポート/別デプロイ（原則 3）

# Twilio に登録した URL と 1 文字も違ってはいけない（署名検証の入力になる）。
# 開発中は cloudflared / ngrok の URL を入れ、変わったら Twilio 側も更新する。
# 片方だけ更新すると Webhook が全件 403 になり、原因が分かりにくい。
PUBLIC_BASE_URL=https://xxxx.trycloudflare.com
PUBLIC_WSS_URL=wss://xxxx.trycloudflare.com

# ---------------------------------------------------------------- データベース

DATABASE_URL=postgresql+asyncpg://app_user:CHANGE_ME@localhost:5432/calling
# マイグレーションと管理バッチ用。BYPASSRLS を持つロール。
# ★ アプリ側にこの接続情報を渡さない（RLS を素通りしてしまう）
DATABASE_MIGRATOR_URL=postgresql+asyncpg://migrator:CHANGE_ME@localhost:5432/calling

REDIS_URL=redis://localhost:6379/0  # media ワーカー → web ワーカーの Pub/Sub

# ---------------------------------------------------------------- 認証

JWT_SECRET=                         # openssl rand -hex 32
JWT_TTL_MINUTES=120

# ---------------------------------------------------------------- Twilio

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=                  # ★ 署名検証に使う。API Key とは別物
# ブラウザソフトフォン用の API Key（Auth Token を直接使わない）
TWILIO_API_KEY_SID=SK...
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=AP...

# 発信者番号。Twilio で購入したか検証済みの番号でないと発信自体が失敗する。
# 複数用意する場合はカンマ区切り。相手ごとに固定して割り当てる
# （毎回違う番号からかかると不審に思われる。references/telephony.md）
TWILIO_CALLER_ID=+815012345678
TWILIO_CALLER_ID_POOL=

# DetectMessageEnd | Enable | (空=無効)
# DetectMessageEnd は精度が高い代わりに応答後 3〜5 秒の無音が入る
TWILIO_MACHINE_DETECTION=DetectMessageEnd

# ---------------------------------------------------------------- 架電ポリシー

# テナント設定の既定値。実際の値は tenants テーブルが持つ
CALLING_TIMEZONE=Asia/Tokyo
CALLING_HOURS_START=09:00
CALLING_HOURS_END=20:00
CALLING_EXCLUDE_HOLIDAYS=true
MAX_ATTEMPTS_PER_DAY=3
MAX_ATTEMPTS_TOTAL=8
RESERVATION_TTL_SECONDS=600         # 担当者が落ちても 10 分で対象に戻る
AGENT_HEARTBEAT_TIMEOUT_SECONDS=60

# 障害時に発信だけを止めるフラグ。アプリ全体を巻き戻さずに済む
DIALING_ENABLED=true

# ---------------------------------------------------------------- ASR / LLM

# deepgram | google | azure | none
ASR_PROVIDER=deepgram
ASR_API_KEY=
ASR_LANGUAGE=ja-JP
ASR_SAMPLE_RATE=8000                # Twilio は μ-law 8kHz。上げても情報は増えない

SILENCE_THRESHOLD_MS=700            # 発話の切れ目の判定。現場で調整する
MIN_UTTERANCE_MS=800                # これより短い相槌ではサジェストしない

LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=120                  # ★ 短く。通話中に読める量は 1〜2 行

# 原価上限に達したら支援だけ止め、通話は止めない
AI_MONTHLY_MINUTES_LIMIT=

# ---------------------------------------------------------------- ストレージ

# 録音は自社ストレージにコピーしてから配る。Twilio の URL を直接渡さない
RECORDING_BUCKET=
RECORDING_REGION=
RECORDING_ACCESS_KEY_ID=
RECORDING_SECRET_ACCESS_KEY=
RECORDING_RETENTION_DAYS=365        # 無期限にしない。消す仕組みを最初に作る

# ---------------------------------------------------------------- フロント

# Next.js から FastAPI への中継先（サーバー側からのみ使う）
API_BASE_URL=http://localhost:8000
# ブラウザに渡ってよい値だけ NEXT_PUBLIC_ を付ける。
# ★ TWILIO_* は 1 つも NEXT_PUBLIC_ にしない
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_WSS_URL=wss://xxxx.trycloudflare.com
